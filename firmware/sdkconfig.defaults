CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Verified with esp-emu v0.39.0, which reports ESP32-P4 revision v3.1.
# Physical P4-NANO and TAB5 revision compatibility remains unverified.
CONFIG_ESP32P4_REV_MIN_301=y

# Phase 3: enable the pinned ESP-IDF PSRAM heap and external BSS support.
# Keep the P4 mode/speed defaults from ESP-IDF 5.5.4.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Step 6A.1: the approved common validation envelope is 8 MiB.  The raw
# NP2TEST fixture remains at its reviewed offset and the application remains
# in the existing 1 MiB factory partition.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Step 6A.1 FATFS/WL contract.  The 64-byte neutral component limit is
# sufficient for the UTF-8 LFN contract used by storage_fatfs.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_MAX_LFN=64
CONFIG_FATFS_SECTOR_4096=y
CONFIG_WL_SECTOR_SIZE_4096=y
